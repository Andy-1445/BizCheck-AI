BIZCHECK_ENVIRONMENT=development
# Exact browser origins only; no wildcard, path, query or fragment.
# Production requires one or more explicit HTTPS frontend origins.
BIZCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production example:
# BIZCHECK_ENVIRONMENT=production
# BIZCHECK_CORS_ORIGINS=https://app.example.com,https://www.example.com
BIZCHECK_GCIS_BASE_URL=https://data.gcis.nat.gov.tw/od/data/api
BIZCHECK_GCIS_TIMEOUT_SECONDS=10
# Number of retries after the first attempt. Allowed range: 0-3.
BIZCHECK_GCIS_MAX_RETRIES=1
# Exponential retry delay base in seconds. Each delay is capped at 10 seconds.
BIZCHECK_GCIS_RETRY_BACKOFF_SECONDS=0.2
# Readiness probes use this shorter timeout and never retry.
BIZCHECK_GCIS_PROBE_TIMEOUT_SECONDS=2
# Process-local normalized response cache: 5 minutes fresh, then up to 6 hours
# stale-if-error. Entries reset whenever the API process restarts.
BIZCHECK_GCIS_CACHE_MAX_ENTRIES=256
BIZCHECK_GCIS_CACHE_TTL_SECONDS=300
BIZCHECK_GCIS_CACHE_STALE_IF_ERROR_SECONDS=21600
BIZCHECK_BENCHMARK_CATALOG_VERSION=benchmark-catalog-2026-08-01-v1
# Set these to your own local files when benchmark data is available.
# BIZCHECK_BENCHMARK_CATALOG_PATH=./data/benchmarks/benchmark-catalog-2026-08-01-v1.json
# BIZCHECK_BENCHMARK_DATABASE_PATH=./data/benchmarks/bizcheck-benchmark.sqlite3
BIZCHECK_LLM_PROVIDER=disabled
BIZCHECK_OPENAI_API_KEY=
BIZCHECK_OPENAI_BASE_URL=https://api.openai.com/v1
BIZCHECK_OPENAI_MODEL=gpt-5.4
# To use Tunghai University's Chat Completions API, set the provider to `thu`
# and configure these values instead of the OpenAI values above.
BIZCHECK_THU_API_KEY=
BIZCHECK_THU_BASE_URL=https://api.ithu.tw/v1
BIZCHECK_THU_MODEL=gpt-oss-120b
# auto tries json_schema, then json_object, and only downgrades on HTTP 400/422.
BIZCHECK_THU_JSON_MODE=auto
BIZCHECK_THU_TEMPERATURE=0.1
BIZCHECK_LLM_TIMEOUT_SECONDS=45
BIZCHECK_LLM_MAX_OUTPUT_TOKENS=3000
# 2 allows one bounded schema/safety repair retry; allowed range is 1-3.
BIZCHECK_LLM_MAX_ATTEMPTS=2
# AI PK v1 uses a bounded process-local result cache. It resets on restart and
# is not shared between multiple Uvicorn workers.
BIZCHECK_LLM_COMPARISON_CACHE_MAX_ENTRIES=128
BIZCHECK_LLM_COMPARISON_CACHE_TTL_SECONDS=900
BIZCHECK_LLM_COMPARISON_CACHE_STALE_IF_ERROR_SECONDS=3600
